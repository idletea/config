title = " "
theme = "Kanagawa Dragon"

# font
font-family = "Iosevka NFM"
font-size = 16

# working dir
window-inherit-working-directory = false
working-directory = home

# splits
## split colours
unfocused-split-fill = #666666
split-divider-color = #888888
## split opening
keybind = super+s=new_split:right
keybind = ctrl+super+s=new_split:down
## split movement
keybind = "ctrl+alt+h=goto_split:left"
keybind = "ctrl+alt+j=goto_split:down"
keybind = "ctrl+alt+k=goto_split:up"
keybind = "ctrl+alt+l=goto_split:right"

# claude
keybind = shift+enter=text:\x1b\r
